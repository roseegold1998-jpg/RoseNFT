* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: linear-gradient(to bottom right, #f0f0f0, #d9d9ff);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.converter-container {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
    text-align: center;
    width: 350px;
}

h1 {
    margin-bottom: 20px;
    font-size: 22px;
}

.converter-box input {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 16px;
}

.dropdowns {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
}

select {
    width: 45%;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #ccc;
    font-size: 14px;
}

.arrow {
    font-size: 18px;
    font-weight: bold;
}

button {
    width: 100%;
    padding: 12px;
    background: #4a4aff;
    color: white;
    font-size: 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #0000cc;
}

#result {
    margin-top: 15px;
    font-size: 18px;
    font-weight: bold;
}

.footer-text {
    margin-top: 20px;
    font-size: 12px;
    color: #555;
}
